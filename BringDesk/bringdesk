
#!/bin/bash

# Terminal colors
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
RESET='\033[0m'

desktop_dir=$(xdg-user-dir DESKTOP)

if [[ -z "$1" ]]; then
    echo -e "${YELLOW}Usage: bringdesk <application-name>${RESET}"
    exit 1
fi

search() {
    local query="$*"
    local -a directories=(
        "$HOME/.local/share/applications"
        "/usr/share/applications"
        "/usr/local/share/applications"
        "/var/lib/snapd/desktop/applications"
        "/var/lib/flatpak/exports/share/applications"
        "$HOME/.local/share/flatpak/exports/share/applications"
    )

    local -a existing=()
    local dir

    for dir in "${directories[@]}"; do
        [[ -d $dir ]] && existing+=("$dir")
    done

    apps=()
    (( ${#existing[@]} )) || return 1

    mapfile -t apps < <(
        grep -RliE --include='*.desktop' -- "^Name=.*${query}" "${existing[@]}" 2>/dev/null
    )
}

echo -e "${CYAN}${BOLD}BringDesk${RESET}"
echo -e "Searching for: ${YELLOW}$1${RESET}"

search "$1"

if [ ${#apps[@]} -eq 0 ]; then
    echo -e "${RED}No applications found matching '$1'.${RESET}"
    exit 1
fi

echo
echo -e "${GREEN}Found application(s):${RESET}"

for i in "${!apps[@]}"; do
    echo -e "${CYAN}$((i + 1))${RESET}: ${apps[$i]}"
done

echo
read -p "Choose an application (1-${#apps[@]}): " choice

cp "${apps[$((choice - 1))]}" "$desktop_dir/" || {
    echo -e "${RED}Error: Failed to copy the shortcut to Desktop.${RESET}" >&2
    exit 1
}

echo
echo -e "${GREEN}${BOLD}Shortcut created successfully!${RESET}"
echo -e "${YELLOW}Right-click the shortcut and select 'Allow Launching'.${RESET}"
